# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://snugandknot.com

# ─── Database ────────────────────────────────────────────────────────────
# Any PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS…).
# The schema is created and the catalogue seeded automatically on first connect.
# Leave unset to use the built-in PGlite database: persisted to .data/ in
# `npm run dev`, in-memory everywhere else (changes are lost on restart).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ─── Auth ────────────────────────────────────────────────────────────────
# Signs session cookies. Use a long random string, e.g. `openssl rand -base64 32`.
# When unset, a key derived from DATABASE_URL is used.
# AUTH_SECRET=

# The store owner's admin login for /admin. Signing in with these values creates
# (or updates) the admin account automatically. Password: 8+ characters.
# Example values for local development only — never reuse them in production.
ADMIN_EMAIL=admin@snugandknot.test
ADMIN_PASSWORD=atelier-dev-2026
