# Copy to .env.local for local development, and set the same names in Vercel →
# Project → Settings → Environment Variables for production. Never commit real values.

# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://snugandknot.com

# Store notices by email (orders, returns, reviews, messages, stock, security…). Without one of the
# two options below, notices are only recorded in Admin → Emails.
#
# Option 1 — a Gmail account through the Gmail API (send-only scope). Notices go to GMAIL_USER.
# GMAIL_USER=you@gmail.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
#
# Option 2 — any SMTP mailbox (Hostinger: smtp.hostinger.com, port 465). Used when Gmail is not set.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=support@snugandknot.com
# SMTP_PASS=
#
# MAIL_FROM="Snug&Knot <you@gmail.com>"
# NOTIFY_EMAIL=

# Search engine ownership checks (optional): the HTML-tag codes from Google Search
# Console and Bing Webmaster Tools.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# ─── Database ────────────────────────────────────────────────────────────
# Any PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS…).
# The schema is created and the catalogue seeded automatically on first connect.
# Remote databases are reached over TLS with the certificate verified.
# Leave unset to use the built-in PGlite database: persisted to .data/ in
# `npm run dev`, in-memory everywhere else (changes are lost on restart).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=verify-full
# If an integration already owns DATABASE_URL for another app, set this instead (it wins):
# SNUGKNOT_DATABASE_URL=postgres://user:password@host/dbname?sslmode=verify-full

# ─── Auth ────────────────────────────────────────────────────────────────
# Signs session cookies: at least 32 characters. Set it in production (without it,
# a key is derived from DATABASE_URL). Generate one with:  openssl rand -base64 32
# Changing it signs everyone out.
# AUTH_SECRET=

# The store owner's admin login for /admin. Signing in with these values creates
# (or takes over) the admin account. The password must be 12+ characters.
# Changing ADMIN_PASSWORD immediately ends every admin session and retires the old
# password. If you change ADMIN_EMAIL, the old address loses its admin sign-in.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
